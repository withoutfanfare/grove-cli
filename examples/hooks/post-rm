#!/bin/bash
# Clean up after removing a worktree
#
# This hook runs after 'grove rm' removes a worktree.
# Use it to clean up any external references to the worktree.

echo "  Worktree removed: ${GROVE_PATH##*/}"

# Example: Remove from projects registry
PROJECTS_FILE="$HOME/.projects"
PROJECT_KEY="${GROVE_PATH##*/}"

if [[ -L "$PROJECTS_FILE" ]]; then
  echo "  Refusing to replace symlinked project registry: $PROJECTS_FILE"
  exit 1
fi

if [[ -f "$PROJECTS_FILE" ]]; then
  projects_tmp="$(mktemp "${PROJECTS_FILE}.tmp.XXXXXX")" || exit 1
  found=false
  while IFS= read -r line || [[ -n "$line" ]]; do
    if [[ "$line" == "$PROJECT_KEY="* ]]; then
      found=true
    else
      printf '%s\n' "$line" >> "$projects_tmp"
    fi
  done < "$PROJECTS_FILE"

  if [[ "$found" != "true" ]]; then
    rm -f "$projects_tmp"
    exit 0
  fi

  mv "$projects_tmp" "$PROJECTS_FILE"
  echo "  Unregistered project: ${PROJECT_KEY}"
fi
